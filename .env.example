# ========================================================
# EduSolve AI - Environment Configuration (.env.example)
# ========================================================
# Copy this file to '.env' and fill in your credentials.
# Command: cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. HUGGING FACE INFERENCE API (100% FREE)
# --------------------------------------------------------
# Recommended for this assignment if you don't have paid OpenAI!
# Steps to get your free token:
#   1. Sign up / Log in at https://huggingface.co
#   2. Go to https://huggingface.co/settings/tokens
#   3. Click "Create new token" -> Type: "Read"
#   4. Paste the token below:
HF_TOKEN=hf_your_free_huggingface_token_here

# Hugging Face default free serverless model:
# Examples:
#   meta-llama/Llama-3.2-3B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
#   Qwen/Qwen2.5-7B-Instruct
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct


# --------------------------------------------------------
# 2. OPENAI API (Official OR Free OpenAI-Compatible APIs)
# --------------------------------------------------------
# Option A: Official OpenAI Key (Requires paid account/credits)
#   Get from: https://platform.openai.com/api-keys
#
# Option B: GitHub Models (100% FREE access to OpenAI gpt-4o-mini & gpt-4o!)
#   1. Go to https://github.com/settings/tokens
#   2. Generate a Personal Access Token (classic or fine-grained)
#   3. Paste token as OPENAI_API_KEY below
#   4. Uncomment OPENAI_BASE_URL below
#
# Option C: Groq (100% FREE, ultra-fast OpenAI-compatible)
#   1. Get key at https://console.groq.com/keys
#   2. Paste key below and set OPENAI_BASE_URL to https://api.groq.com/openai/v1
# --------------------------------------------------------
OPENAI_API_KEY=your_openai_or_github_token_here
OPENAI_MODEL=gpt-4o-mini

# Uncomment if using GitHub Models or Groq:
# OPENAI_BASE_URL=https://models.inference.ai.azure.com
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
